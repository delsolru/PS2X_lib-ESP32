# Keep the sources portable: one canonical line ending, no binary surprises.
* text=auto eol=lf

*.ino    text eol=lf
*.h      text eol=lf
*.cpp    text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.txt    text eol=lf

LICENSE  text eol=lf
NOTICE   text eol=lf

*.zip    binary
*.png    binary
*.jpg    binary
